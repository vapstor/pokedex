<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Pokedex" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores principais -->
        <item name="colorPrimary">@color/crimson_300</item>
        <item name="colorOnPrimary">@color/slate_950</item>
        <item name="colorPrimaryContainer">@color/crimson_900_muted</item>
        <item name="colorOnPrimaryContainer">@color/crimson_100</item>

        <!-- Cores secundárias -->
        <item name="colorSecondary">@color/teal_300</item>
        <item name="colorOnSecondary">@color/slate_950</item>
        <item name="colorSecondaryContainer">@color/teal_900_muted</item>
        <item name="colorOnSecondaryContainer">@color/teal_100</item>

        <!-- Superfícies e fundo -->
        <item name="android:colorBackground">@color/slate_950</item>
        <item name="colorSurface">@color/slate_950</item>
        <item name="colorOnSurface">@color/slate_100</item>
        <item name="colorSurfaceVariant">@color/slate_800</item>
        <item name="colorOnSurfaceVariant">@color/slate_200</item>
        <item name="colorOutline">@color/slate_700</item>

        <!-- Erro -->
        <item name="colorError">@color/error_dark</item>

        <!-- Edge-to-edge limpo -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>

</resources>